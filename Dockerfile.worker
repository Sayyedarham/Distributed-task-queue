FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY tasks.py .

# Concurrency=4 workers per pod; prefetch=1 prevents task hoarding
CMD ["celery", "-A", "tasks", "worker", \
     "--loglevel=info", \
     "--concurrency=4", \
     "--prefetch-multiplier=1"]